{
  "cast": {
    "TAKUTO": { "voice": [["am_michael", 0.6], ["am_puck", 0.4]], "speed": 0.95 },
    "NEMU":   { "voice": [["af_nicole", 0.65], ["af_bella", 0.35]], "speed": 0.93 },
    "???":    { "voice": [["af_nicole", 0.65], ["af_bella", 0.35]], "speed": 1.05 },
    "SIEG":   { "voice": [["bm_george", 1.0]], "speed": 1.0 },
    "AKURO":  { "voice": [["am_fenrir", 1.0]], "speed": 0.8, "fx": "demon" },
    "SABLE":  { "voice": [["bm_fable", 1.0]], "speed": 0.92, "fx": "static" }
  },
  "lines": [
    { "id": "c1", "who": "AKURO", "text": "Tell me, boy..." },
    { "id": "c2", "who": "AKURO", "text": "...what is it you want to break?" },
    { "id": "c3", "who": "TAKUTO", "text": "Everything that's in the way." },

    { "id": "e1", "who": "TAKUTO", "mono": true, "text": "Two-fourteen. Last freight of the night." },
    { "id": "e2", "who": "TAKUTO", "mono": true, "text": "Same crossing. Same bell." },
    { "id": "e3", "who": "TAKUTO", "mono": true, "text": "Same cat." },
    { "id": "e4", "who": "TAKUTO", "mono": true, "text": "It was Haruki's cat first. He fed it every night on his way home.", "tts": "It was Hah-roo-kee's cat first. He fed it every night, on his way home." },
    { "id": "e5", "who": "TAKUTO", "mono": true, "text": "Two years now." },
    { "id": "e6", "who": "TAKUTO", "mono": true, "text": "So I bring the cat food. Somebody has to." },
    { "id": "e7", "who": "TAKUTO", "text": "Tuna. The expensive kind. Don't tell anyone." },
    { "id": "e8", "who": "TAKUTO", "mono": true, "text": "Grandma used to say I was born to carry things for other people." },
    { "id": "e9", "who": "TAKUTO", "text": "...What is it?" },
    { "id": "e10", "who": "TAKUTO", "mono": true, "text": "The bell... There's no train." },
    { "id": "e11", "who": "TAKUTO", "text": "...Okay. No." },
    { "id": "e12", "who": "???", "text": "Don't come near it!", "speed": 1.12 },
    { "id": "e13", "who": "TAKUTO", "text": "Hey!", "speed": 1.1 },
    { "id": "e14", "who": "TAKUTO", "text": "Get down!", "speed": 1.15 },

    { "id": "a1", "who": "TAKUTO", "mono": true, "text": "...Two moons." },
    { "id": "a2", "who": "TAKUTO", "mono": true, "text": "Okay. That's new." },
    { "id": "a3", "who": "TAKUTO", "mono": true, "text": "And I'm holding... an axe?" },
    { "id": "a4", "who": "TAKUTO", "mono": true, "text": "Where the hell am I?" },
    { "id": "a5", "who": "NEMU", "text": "Hnnnaaah... Oh. You're alive. Neat.", "tts": "Hhaaaaah... Oh. You're alive. Neat." },
    { "id": "a6", "who": "TAKUTO", "text": "You were lying on train tracks a minute ago." },
    { "id": "a7", "who": "NEMU", "text": "Mm. I'm very good at that." },
    { "id": "a8", "who": "NEMU", "text": "Lying places. Getting squished." },
    { "id": "a9", "who": "TAKUTO", "text": "Where is this?" },
    { "id": "a10", "who": "NEMU", "text": "The Barrow Fields. Edge of the Ashen March." },
    { "id": "a11", "who": "NEMU", "text": "You fell out of the sky." },
    { "id": "a12", "who": "NEMU", "text": "People like you have a name here. Skyfallen." },
    { "id": "a13", "who": "TAKUTO", "text": "There are others?" },
    { "id": "a14", "who": "NEMU", "text": "A few. Most of them land worse." },
    { "id": "a15", "who": "TAKUTO", "text": "...I'll take that as a compliment." },
    { "id": "a16", "who": "NEMU", "text": "...Hey." },
    { "id": "a17", "who": "NEMU", "text": "Where did you get that axe?" },
    { "id": "a18", "who": "TAKUTO", "text": "It was sticking out of a grave. I grabbed it on the way down." },
    { "id": "a19", "who": "NEMU", "text": "That's the Headsman's Axe." },
    { "id": "a20", "who": "NEMU", "text": "It's been stuck in that grave for three hundred years." },
    { "id": "a21", "who": "NEMU", "text": "People tried pulling it out with horses." },
    { "id": "a22", "who": "TAKUTO", "text": "...It was loose." },
    { "id": "a23", "who": "NEMU", "text": "WHY WAS IT LOOSE?!", "tts": "Why was it loose?!", "speed": 1.15 },
    { "id": "a24", "who": "NEMU", "text": "Rifts open in the sky. Things crawl out." },
    { "id": "a25", "who": "NEMU", "text": "We call them Fiends." },
    { "id": "a26", "who": "NEMU", "text": "Swords don't bite them. Arrows bounce off." },
    { "id": "a27", "who": "NEMU", "text": "Normal people can't do anything but run." },
    { "id": "a28", "who": "NEMU", "text": "Unless you have a Brand." },
    { "id": "a29", "who": "NEMU", "text": "A mark on your soul. It wakes up when you're about to die... if you have one." },
    { "id": "a30", "who": "NEMU", "text": "Branded people become Hunters. They hunt Fiends for the Guild." },
    { "id": "a31", "who": "TAKUTO", "text": "And people without one?" },
    { "id": "a32", "who": "NEMU", "text": "Get very good at running." },
    { "id": "a33", "who": "NEMU", "text": "Mine's called Nine Lives." },
    { "id": "a34", "who": "NEMU", "text": "I can die nine times. I've used six." },
    { "id": "a35", "who": "TAKUTO", "text": "Six." },
    { "id": "a36", "who": "NEMU", "text": "Don't make the face." },
    { "id": "a37", "who": "TAKUTO", "text": "I'm not making a face." },
    { "id": "a38", "who": "NEMU", "text": "You're making it with your eyes." },
    { "id": "a39", "who": "TAKUTO", "text": "That thing at the crossing. Was it chasing you?" },
    { "id": "a40", "who": "NEMU", "text": "I was digging for grave silver. It woke up. Shieldbearers don't wake up." },
    { "id": "a41", "who": "NEMU", "text": "Then the ground opened. Rifts open in the sky... not into other worlds." },
    { "id": "a42", "who": "NEMU", "text": "Somebody opened that one." },
    { "id": "a43", "who": "TAKUTO", "text": "...You hear that?" },
    { "id": "a44", "who": "NEMU", "text": "A bell. There are no bells out here." },

    { "id": "b1", "who": "NEMU", "text": "Run. I mean it this time.", "speed": 1.05 },
    { "id": "b2", "who": "TAKUTO", "text": "You said that at the crossing." },
    { "id": "b3", "who": "NEMU", "text": "And you didn't listen! I only have three left!", "speed": 1.12 },
    { "id": "b4", "who": "TAKUTO", "text": "Then stay behind me." },
    { "id": "b5", "who": "NEMU", "text": "Don't hit the shield! Nothing breaks the shield!", "speed": 1.15 },
    { "id": "b6", "who": "TAKUTO", "text": "Then what do I hit?!", "speed": 1.1 },
    { "id": "b7", "who": "NEMU", "text": "Nothing! We run!", "speed": 1.15 },
    { "id": "b8", "who": "TAKUTO", "mono": true, "text": "Can't... get up...", "speed": 0.85 },
    { "id": "b9", "who": "NEMU", "text": "Hey! Ugly!", "speed": 1.1 },
    { "id": "b10", "who": "NEMU", "text": "Over here!", "speed": 1.12 },
    { "id": "b11", "who": "TAKUTO", "text": "Wait!", "speed": 1.15 },
    { "id": "b12", "who": "TAKUTO", "mono": true, "text": "Born to carry things for other people.", "speed": 0.9 },
    { "id": "b13", "who": "TAKUTO", "mono": true, "text": "Groceries. Grudges. Blame.", "speed": 0.88 },
    { "id": "b14", "who": "TAKUTO", "mono": true, "text": "Not this. I'm not carrying this one.", "speed": 0.9 },
    { "id": "b15", "who": "AKURO", "text": "Finally." },
    { "id": "b16", "who": "AKURO", "text": "Three hundred years in the dirt, and this is who pulls me out?" },
    { "id": "b17", "who": "TAKUTO", "text": "Who are you?" },
    { "id": "b18", "who": "AKURO", "text": "The reason the axe was stuck." },
    { "id": "b19", "who": "AKURO", "text": "Tell me, boy. What is it you want to break?" },
    { "id": "b20", "who": "TAKUTO", "text": "Everything that's in the way." },
    { "id": "b21", "who": "AKURO", "text": "...Good answer." },
    { "id": "b22", "who": "TAKUTO", "text": "It was in the way." },
    { "id": "b23", "who": "NEMU", "text": "Hnnaaah... Ow.", "tts": "Hhaaaah... Ow." },
    { "id": "b24", "who": "TAKUTO", "text": "You were dead." },
    { "id": "b25", "who": "NEMU", "text": "Mm. That's seven. Two left." },
    { "id": "b26", "who": "TAKUTO", "text": "Don't do that again." },
    { "id": "b27", "who": "NEMU", "text": "You're making the face." },
    { "id": "b28", "who": "TAKUTO", "text": "I'm making it with my whole face this time." },
    { "id": "b29", "who": "TAKUTO", "text": "...I never asked your name." },
    { "id": "b30", "who": "NEMU", "text": "Nemu.", "tts": "Neh-moo." },
    { "id": "b31", "who": "NEMU", "text": "And you're the idiot who pulled out the Headsman's Axe." },
    { "id": "b32", "who": "TAKUTO", "text": "Takuto. Kirishima Takuto.", "tts": "Tah-koo-toh. Kee-ree-shee-mah, Tah-koo-toh." },
    { "id": "b33", "who": "SIEG", "text": "Well, well, well." },
    { "id": "b34", "who": "SIEG", "text": "A Shieldbearer's shield. Broken in one swing." },
    { "id": "b35", "who": "SIEG", "text": "Twelve years I've been hunting. Never seen that." },
    { "id": "b36", "who": "SIEG", "text": "Nice axe, kid. Mind telling me where you got it?" },
    { "id": "b37", "who": "TAKUTO", "text": "It was loose." },
    { "id": "b38", "who": "NEMU", "text": "He keeps saying that." },
    { "id": "b39", "who": "SIEG", "text": "Ha! It was loose, he says." },
    { "id": "b40", "who": "SIEG", "text": "You two had better come with me. Because that..." },
    { "id": "b41", "who": "SIEG", "text": "...is not supposed to stay open." },
    { "id": "b42", "who": "AKURO", "text": "We're going to have so much fun, you and I." },

    { "id": "s1", "who": "SABLE", "text": "One fell through." },
    { "id": "s2", "who": "SABLE", "text": "...Good." },

    { "id": "p1", "who": "TAKUTO", "text": "Next time: the Hunters' Guild." },
    { "id": "p2", "who": "TAKUTO", "text": "A test that reads my rank as ERROR...", "tts": "A test that reads my rank as error..." },
    { "id": "p3", "who": "TAKUTO", "text": "...and a girl with a red scarf who hates me on sight." },
    { "id": "p4", "who": "TAKUTO", "text": "Why does she have my hair?" },
    { "id": "p5", "who": "TAKUTO", "text": "Episode two. Branded." }
  ]
}
